<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings screen (T08, DESIGN.md section 3): a plain vertical list, one row per
  setting, platform widgets only (Switch, SeekBar, Button, RadioButton), no custom
  palette and no illustrations. Typography (DESIGN.md section 2): screen title 20sp,
  section titles 14sp medium (sans-serif-medium is the platform default family's
  medium weight), body 16sp, helper 14sp; sentence case (textAllCaps=false keeps the
  platform buttons from transforming it). Spacing follows the locked 4dp base grid:
  4dp inner gaps, 8dp tight gaps, 16dp screen padding and section gaps (4 x base).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_service_status"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/enable_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/enable_button"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_size"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/size_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/size_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size_small"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/size_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size_medium"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/size_large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size_large"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_handle_opacity"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/opacity_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/section_handle_opacity"
            android:min="30"
            android:max="100" />

        <TextView
            android:id="@+id/opacity_readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_auto_collapse_timeout"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/timeout_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/section_auto_collapse_timeout"
            android:min="1"
            android:max="10" />

        <TextView
            android:id="@+id/timeout_readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/haptics_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/haptics_switch"
            android:textSize="16sp" />

        <Button
            android:id="@+id/reset_position_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reset_position_button"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_how_to_enable"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/onboarding_step_1"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/onboarding_step_2"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/onboarding_step_3"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/onboarding_step_4"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboarding_vivo_helper"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
