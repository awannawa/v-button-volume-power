    <string name="section_how_to_enable">How to enable</string>
    <string name="onboarding_step_1">1. Open the Accessibility settings.</string>
    <string name="onboarding_step_2">2. Find Virtual Buttons and open it.</string>
    <string name="onboarding_step_3">3. Turn the service on.</string>
    <!-- (Android 13+) is the ruled helper note: restricted settings apply to
         sideloaded apps from Android 13 (PRD R3). -->
    <string name="onboarding_step_4">4. If the toggle is blocked (Android 13+): open App info, tap the three-dot menu, tap Allow restricted settings, then turn the service on.</string>

    <!-- Vivo resilience guide (T09, PRD R2). The paths are the Funtouch OS locations,
         stated literally; no claim is made about what Vivo guarantees. -->
    <string name="section_vivo_keep_alive">Keep the service running on Vivo (Funtouch OS)</string>
    <string name="vivo_step_1">1. Enable Autostart for Virtual Buttons (Settings → Battery, or the i Manager app → App manager → Autostart).</string>
    <string name="vivo_step_2">2. Set Battery to unrestricted (Settings → Battery → Background power consumption management, or App info → Battery → Unrestricted).</string>
    <string name="vivo_step_3">3. Lock the app in Recents: tap the app\'s lock icon in the recents screen.</string>
    <string name="vivo_battery_button">Battery optimization settings</string>
